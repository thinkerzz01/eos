# Thinkerzz EOS - environment variables (TEMPLATE, no real values).
# Copy to .env.local for development (.env.local is gitignored - never commit real secrets).
# In production, set these in the host's environment (Hostinger Node.js app env vars).

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only; NEVER expose to the browser

# --- App URLs ---
# Functional URL used for the set-password redirect + login link.
# Dev: http://localhost:3000   Prod: https://portal.thinkerzz.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL shown to users for the portal (defaults to https://portal.thinkerzz.com if unset).
NEXT_PUBLIC_PORTAL_URL=https://portal.thinkerzz.com
# Single-tenant org id the public /book form creates leads under.
BOOKING_ORG_ID=00000000-0000-0000-0000-000000000001

# --- Cron auth (required for automation) ---
# Long random string; must match the Authorization: Bearer header in the cron jobs.
CRON_SECRET_TOKEN=generate-a-long-random-string

# --- Bot protection for the public forms (Cloudflare Turnstile) ---
# Optional but STRONGLY recommended for production. Get a free widget at
# Cloudflare -> Turnstile. Leave BOTH blank to disable (forms then rely only on
# the built-in per-IP rate limit). Set BOTH to require the challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=your-resend-key
RESEND_FROM=no-reply@portal.thinkerzz.com

# --- Monthly-report phrasing (OpenRouter, optional - falls back to plain text) ---
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Google Calendar + Meet (class/demo invites) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token   # from an account you own; publish the consent screen to Production
GOOGLE_CALENDAR_ID=primary

# --- Academy contact / branding (public) ---
NEXT_PUBLIC_ACADEMY_WHATSAPP=923000000000
NEXT_PUBLIC_ACADEMY_EMAIL=thinkerzz01@gmail.com   # the calendar-invite sender (used in the Save Contact vCard)
NEXT_PUBLIC_EMAIL_LOGO_URL=                        # optional hosted logo for emails (else the THINKERZZ wordmark)

# --- Fee payment instructions shown to students (public) ---
BANK_NAME_TITLE=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_IBAN=
MOBILE_WALLET_INFO=
